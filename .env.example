# Copy to .env. All values below are placeholders. Use a separate database for demo.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"
BETTER_AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# demo or live. Demo still uses PostgreSQL; never sends social API requests.
APP_MODE="demo"
# Base64 encoded 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-4.1-mini"
OPENAI_IMAGE_MODEL="gpt-image-1"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
INNGEST_DEV="1"
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_API_VERSION="v24.0"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""
# Resend for password recovery; unset disables recovery with setup guidance.
RESEND_API_KEY=""
EMAIL_FROM=""
