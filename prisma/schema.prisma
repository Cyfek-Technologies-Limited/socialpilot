generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  memberships WorkspaceMember[]
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model RateLimit {
  id String @id @default(cuid())
  key String @unique
  count Int
  lastRequest BigInt
}
enum Role { 
  OWNER
  ADMIN
  EDITOR
  VIEWER
}
enum ApprovalState {
  DRAFT
  IN_REVIEW
  APPROVED
}
enum DeliveryState {
  UNSCHEDULED
  SCHEDULED
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
  RECONCILE
}
model Workspace {
  id String @id @default(cuid())
  name String
  timezone String @default("Africa/Lagos")
  language String @default("en")
  mode String @default("demo")
  paused Boolean @default(false)
  onboardingStep Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members WorkspaceMember[]
  brands Brand[]
  plans ContentPlan[]
  auditLogs AuditLog[]
  usage UsageEvent[]
  notifications Notification[]
  limits Json @default("{\"text\":100,\"image\":20,\"reply\":100,\"scheduled\":100,\"accounts\":5,\"storage\":104857600}")
}
model WorkspaceMember {
  id String @id @default(cuid())
  workspaceId String
  userId String
  role Role @default(EDITOR)
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([workspaceId,userId])
  @@index([userId])
}
model Brand {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  name String
  description String @default("")
  niche String @default("")
  website String @default("")
  audience String @default("")
  location String @default("")
  language String @default("en")
  tone String @default("Warm and helpful")
  goal String @default("awareness")
  cta String @default("")
  colors String[] @default(["#4f46e5", "#eef2ff"])
  preferences Json @default("{}")
  paused Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  knowledge BrandKnowledgeEntry[]
  products ProductOrService[]
  assets BrandAsset[]
  accounts SocialAccount[]
  automation AutomationSettings?
  content ContentItem[]
  @@index([workspaceId])
  @@unique([id,workspaceId])
}
model BrandKnowledgeEntry {
  id String @id @default(cuid())
  workspaceId String
  brandId String
  brand Brand @relation(fields:[brandId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  kind String
  question String
  answer String
  verified Boolean @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workspaceId,brandId])
}
model ProductOrService {
  id String @id @default(cuid())
  workspaceId String
  brandId String
  brand Brand @relation(fields:[brandId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  name String
  description String
  price Decimal? @db.Decimal(12,2)
  currency String @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workspaceId,brandId])
}
model BrandAsset {
  id String @id @default(cuid())
  workspaceId String
  brandId String
  brand Brand @relation(fields:[brandId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  fileName String
  mimeType String
  fileSize Int
  width Int?
  height Int?
  storageKey String @unique
  source String
  prompt String?
  createdAt DateTime @default(now())
  posts PlatformPost[]
  @@index([workspaceId,brandId])
  @@unique([id,workspaceId])
}
model SocialAccount {
  id String @id @default(cuid())
  workspaceId String
  brandId String
  brand Brand @relation(fields:[brandId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  platform String
  providerAccountId String
  username String
  status String @default("CONNECTED")
  mode String
  encryptedToken String?
  tokenExpiresAt DateTime?
  capabilities Json
  autoPublishConsentAt DateTime?
  autoReplyConsentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts PlatformPost[]
  @@unique([workspaceId,platform,providerAccountId])
  @@unique([id,workspaceId])
  @@index([brandId])
}
model AutomationSettings {
  id String @id @default(cuid())
  workspaceId String
  brandId String @unique
  brand Brand @relation(fields:[brandId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  autoPublish Boolean @default(false)
  autoReply Boolean @default(false)
  replyCategories String[] @default([])
  dailyReplyLimit Int @default(5)
  updatedAt DateTime @updatedAt
  @@index([workspaceId])
  @@unique([brandId,workspaceId])
}
model ContentPlan {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  name String
  objective String
  createdAt DateTime @default(now())
  content ContentItem[]
  @@index([workspaceId])
}
model ContentItem {
  id String @id @default(cuid())
  workspaceId String
  brandId String
  brand Brand @relation(fields:[brandId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  planId String?
  plan ContentPlan? @relation(fields:[planId],references:[id],onDelete:SetNull)
  topic String
  category String @default("educational")
  objective String @default("awareness")
  audience String @default("")
  graphicBrief String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts PlatformPost[]
  @@index([workspaceId,brandId])
  @@unique([id,workspaceId])
}
model PlatformPost {
  id String @id @default(cuid())
  workspaceId String
  contentItemId String
  contentItem ContentItem @relation(fields:[contentItemId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  accountId String?
  account SocialAccount? @relation(fields:[accountId,workspaceId],references:[id,workspaceId],onDelete:NoAction)
  platform String @default("instagram")
  caption String
  hashtags String @default("")
  mediaId String?
  media BrandAsset? @relation(fields:[mediaId,workspaceId],references:[id,workspaceId],onDelete:NoAction)
  version Int @default(1)
  approvalState ApprovalState @default(DRAFT)
  deliveryState DeliveryState @default(UNSCHEDULED)
  scheduledAt DateTime?
  timezone String @default("Africa/Lagos")
  publishedAt DateTime?
  providerPostId String?
  providerContainerId String?
  deliveryKey String? @unique
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions PostRevision[]
  approvals Approval[]
  attempts PublishAttempt[]
  comments Comment[]
  @@index([workspaceId,deliveryState,scheduledAt])
  @@unique([id,workspaceId])
}
model PostRevision {
  id String @id @default(cuid())
  workspaceId String
  postId String
  post PlatformPost @relation(fields:[postId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  version Int
  caption String
  hashtags String
  mediaId String?
  actorId String
  createdAt DateTime @default(now())
  @@unique([postId,version])
  @@index([workspaceId])
}
model Approval {
  id String @id @default(cuid())
  workspaceId String
  postId String
  post PlatformPost @relation(fields:[postId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  version Int
  actorId String
  createdAt DateTime @default(now())
  @@unique([postId,version])
  @@index([workspaceId])
}
model PublishAttempt {
  id String @id @default(cuid())
  workspaceId String
  postId String
  post PlatformPost @relation(fields:[postId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  deliveryKey String
  status String
  error String?
  providerPostId String?
  createdAt DateTime @default(now())
  @@index([workspaceId,postId])
}
model BackgroundJob {
  id String @id @default(cuid())
  workspaceId String
  kind String
  key String @unique
  payload Json
  status String @default("PENDING")
  error String?
  externalId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workspaceId,status])
}
model Comment {
  id String @id @default(cuid())
  workspaceId String
  postId String
  post PlatformPost @relation(fields:[postId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  providerCommentId String
  author String
  text String
  status String @default("OPEN")
  assignedTo String?
  createdAt DateTime @default(now())
  replies Reply[]
  @@unique([postId,providerCommentId])
  @@unique([id,workspaceId])
  @@index([workspaceId,status])
}
model Reply {
  id String @id @default(cuid())
  workspaceId String
  commentId String
  comment Comment @relation(fields:[commentId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
  text String
  status String @default("DRAFT")
  providerReplyId String?
  approvedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([commentId])
  @@index([workspaceId])
}
model Notification {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  message String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([workspaceId,read])
}
model UsageEvent {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  kind String
  units Int @default(1)
  status String @default("RESERVED")
  key String @unique
  createdAt DateTime @default(now())
  @@index([workspaceId,kind,createdAt])
}
model AuditLog {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  actorId String
  action String
  resourceId String?
  detail Json @default("{}")
  createdAt DateTime @default(now())
  @@index([workspaceId,createdAt])
}
model OAuthState {
  id String @id
  workspaceId String
  brandId String
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model WebhookEvent {
  id String @id
  createdAt DateTime @default(now())
}
